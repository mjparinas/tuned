{
  "name": "@tuned/shared",
  "version": "0.0.0",
  "private": true,
  "description": "What Tuned's TV apps (Samsung Tizen, Vega OS) share below their screens: playlist, guide and account code in plain TypeScript, over tv/core's Kotlin rules.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./account": "./src/account.ts",
    "./bytes": "./src/bytes.ts",
    "./handoff": "./src/handoff.ts",
    "./login": "./src/login.ts",
    "./platform": "./src/platform.ts",
    "./i18n": "./src/i18n.ts",
    "./guide": "./src/guide.ts",
    "./search": "./src/search.ts",
    "./favourites": "./src/favourites.ts",
    "./tmdb": "./src/tmdb.ts",
    "./filters": "./src/filters.ts",
    "./sort": "./src/sort.ts",
    "./progress": "./src/progress.ts",
    "./reminders": "./src/reminders.ts",
    "./xmltv": "./src/xmltv.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "tuned-core": "file:../core/build/dist/js/productionLibrary"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
