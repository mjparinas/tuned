{
  "name": "tuned-tizen",
  "version": "0.0.0",
  "private": true,
  "description": "Tuned for Samsung TVs: a Tizen web app on AVPlay (docs/decisions/tizen.md).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/*.test.ts",
    "e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@tuned/shared": "file:../shared",
    "fflate": "0.8.3",
    "preact": "11.2.0",
    "qrcode-generator": "2.0.4",
    "tuned-core": "file:../core/build/dist/js/productionLibrary"
  },
  "devDependencies": {
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "vite": "8.4.0"
  }
}
