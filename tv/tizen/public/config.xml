<?xml version="1.0" encoding="UTF-8"?>
<!-- Tuned for Samsung TVs (docs/decisions/tizen.md). TVs from 2020 on (Tizen 5.5). The version is filled in by
     scripts/package.mjs. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="https://www.tunedplayer.com/tizen" version="0.0.0" viewmodes="maximized">
    <tizen:application id="TunedPlayr.Tuned" package="TunedPlayr" required_version="5.5"/>
    <content src="index.html"/>
    <name>Tuned</name>
    <icon src="icon-512.png"/>
    <description>Tuned is an IPTV player for your own playlist (Xtream login or M3U link). It includes no content.</description>
    <author href="https://www.tunedplayer.com">Tuned</author>
    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>
    <!-- Streams and guides come from the person's own provider, at any address, over http or https. -->
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'self' data: blob: 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src * data: blob:; media-src * blob:; connect-src *</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:profile name="tv-samsung"/>
</widget>
