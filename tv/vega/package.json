{
  "name": "@tuned/vega",
  "version": "0.1.0",
  "private": true,
  "description": "Tuned for Fire TV sticks on Vega OS (docs/decisions/vega.md)",
  "scripts": {
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm run build:release",
    "preview": "vite --config preview/vite.config.mjs",
    "preview:build": "vite build --config preview/vite.config.mjs --base ./",
    "screenshots": "node preview/shoot.mjs"
  },
  "dependencies": {
    "@amazon-devices/expo-crypto": "~3.0.2",
    "@amazon-devices/react-native-async-storage__async-storage": "~2.1.0",
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@amazon-devices/react-native-w3cmedia": "~2.3.5",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@tuned/shared": "file:../shared",
    "pako": "2.1.0",
    "qrcode-generator": "1.4.4",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.7",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "playwright": "^1.65.1",
    "react-dom": "19.2.0",
    "react-native-web": "^0.21.1",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.3",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "kepler": {
    "projectType": "application",
    "appName": "Tuned",
    "targets": [
      "tv"
    ]
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  }
}
