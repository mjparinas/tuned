<?xml version="1.0" encoding="utf-8"?>
<!--
  targetCell* size the widget on Android 12+; older launchers use minWidth and minHeight instead. It can shrink to one
  cell (one channel) and grow to a grid; the layout follows the size (FavouritesWidget).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_favourites_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="60dp"
    android:minResizeHeight="60dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
