<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_title">频道状态</string>
    <string name="settings_channel_health_summary">扫描所有频道并隐藏持续失败的频道</string>
    <string name="health_help">扫描会逐个尝试每个直播频道，就像老式电视搜台一样。如果网络中断或服务器停止响应，扫描会等待或停止，而不会归咎于频道。只有在相隔至少六小时的两次扫描中都失败，频道才会被隐藏；一旦扫描发现它恢复正常，就会立即回来。</string>
    <string name="health_scan_now">扫描频道</string>
    <string name="health_stop">停止扫描</string>
    <string name="health_starting">正在开始扫描…</string>
    <string name="health_while_scanning">你观看内容时扫描会暂停，因此始终只打开一个直播流。</string>
    <string name="health_last_scan">上次扫描 %1$s</string>
