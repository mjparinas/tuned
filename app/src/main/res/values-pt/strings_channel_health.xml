    <string name="health_stopped_internet">A varredura parou porque a internet caiu. Nenhum canal foi culpado.</string>
    <string name="health_stopped_server">A varredura parou porque o servidor não estava enviando transmissões. Nenhum canal foi culpado.</string>
    <string name="health_stopped_busy">A varredura parou porque sua conta estava usando todas as conexões, provavelmente em outro dispositivo. Tente mais tarde.</string>
    <string name="health_hide_dead">Ocultar canais que falham sempre</string>
    <string name="health_hide_placeholders">Ocultar canais de eventos vazios</string>
    <string name="health_hide_placeholders_summary">Remove espaços com nomes como “No event streaming” até o provedor colocar um evento real</string>
    <string name="health_hide_dead_summary">Desative para mostrar todos os canais, inclusive os que as varreduras ocultaram</string>
