<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="health_title">Saúde dos canais</string>
    <string name="settings_channel_health_summary">Varre todos os canais e oculta os que falham sempre</string>
    <string name="health_help">Uma varredura testa cada canal ao vivo, um por vez, como as TVs antigas procuravam emissoras. Se a internet cair ou o servidor parar de responder, a varredura espera ou para em vez de culpar os canais. Um canal só é ocultado depois de falhar em duas varreduras com pelo menos seis horas de diferença, e volta assim que uma varredura o encontra funcionando.</string>
    <string name="health_scan_now">Varrer canais</string>
    <string name="health_stop">Parar varredura</string>
    <string name="health_starting">Iniciando a varredura…</string>
    <string name="health_while_scanning">A varredura pausa enquanto você assiste algo, então só uma transmissão fica aberta.</string>
    <string name="health_last_scan">Última varredura %1$s</string>
