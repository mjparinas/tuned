#!/usr/bin/env bash
# Format staged Prettier files before the commit lands (Melvin, 2026-11-24: Prettier kept failing CI).
# Installed by `npm ci` / `npm install` via package.json's prepare (core.hooksPath → this directory).
set -euo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root"

if [[ ! -x node_modules/.bin/prettier ]]; then
  echo "pre-commit: Prettier is missing. Run npm ci at the repo root, then commit again." >&2
  exit 1
fi

# Staged paths Prettier might own (ktlint covers Kotlin; .prettierignore drops the rest).
files=()
while IFS= read -r -d '' f; do
  [[ -z "$f" || ! -f "$f" ]] && continue
  case "$f" in
    *.md | *.mdx | *.json | *.yml | *.yaml | *.html | *.css | *.js | *.mjs | *.cjs | *.ts | *.tsx)
      files+=("$f")
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)
((${#files[@]})) || exit 0

npx prettier --write --ignore-unknown -- "${files[@]}"
git add -- "${files[@]}"
